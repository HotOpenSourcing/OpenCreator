{
  "name": "@opencreator/harness",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prestart": "pnpm --filter @opencreator/protocol build",
    "start": "node init && tsx src/cli.ts",
    "prebuild": "pnpm --filter @opencreator/protocol build",
    "build": "node init && tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @opencreator/protocol build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opencreator/protocol build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opencreator/protocol": "workspace:*"
  }
}
